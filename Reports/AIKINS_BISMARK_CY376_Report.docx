Appendices

Appendix A — Full Python packet_sniffer.py (used in lab)

#!/usr/bin/env python3
"""
packet_sniffer.py
A basic network packet sniffer and simple rule-based detector.
Usage examples:
  sudo python3 packet_sniffer.py --interface eth0 --filter "tcp" --count 500 --output captures/session.pcap --verbose
"""
import argparse
from scapy.all import sniff, wrpcap, TCP, IP, ARP, DNS, Raw
from datetime import datetime
import os
import json
from collections import defaultdict, deque
import time

# Simple state for scan detection and ARP mapping
scan_state = defaultdict(lambda: deque())  # key: (src, dst) -> deque of (ts, dport)
arp_table = {}  # ip -> mac
ALERTS_LOG = "alerts.log"

def log_alert(severity, title, details):
    timestamp = datetime.now().isoformat()
    entry = {"time": timestamp, "severity": severity, "title": title, "details": details}
    with open(ALERTS_LOG, "a") as f:
        f.write(json.dumps(entry) + "\n")
    # print nicely
    print(f"\n{severity} [{title}]")
    for k, v in details.items():
        print(f"    {k}: {v}")
    print()

def check_for_scan(pkt):
    if not pkt.haslayer(TCP) or not pkt.haslayer(IP):
        return
    src = pkt[IP].src
    dst = pkt[IP].dst
    dport = pkt[TCP].dport
    ts = time.time()
    key = (src, dst)
    dq = scan_state[key]
    dq.append((ts, dport))
    # Keep only last 5 seconds
    while dq and (ts - dq[0][0]) > 5.0:
        dq.popleft()
    ports = {p for (_, p) in dq}
    if len(ports) >= 8:
        # port scan detected
        details = {
            "Source": src,
            "Target": dst,
            "Ports scanned": sorted(list(ports)),
            "Scan type": "SYN Scan (heuristic)",
            "Duration": f"{ts - dq[0][0]:.1f}s"
        }
        log_alert("⚠️  [ALERT][HIGH]", "Port Scan Detected!", details)
        dq.clear()

def parse_arp(pkt):
    if not pkt.haslayer(ARP):
        return
    arp = pkt[ARP]
    ip = arp.psrc
    mac = arp.hwsrc
    # If IP exists and MAC changed, possible ARP spoof
    if ip in arp_table and arp_table[ip] != mac:
        details = {
            "Attacker MAC": mac,
            "Claimed IP": ip,
            "Original MAC": arp_table[ip]
        }
        log_alert("🚨 [ALERT][CRITICAL]", "ARP Spoofing Detected!", details)
    else:
        arp_table[ip] = mac

def human_print(pkt):
    ts = datetime.now().strftime("%H:%M:%S")
    if pkt.haslayer(TCP) and pkt.haslayer(IP):
        s = pkt[IP].src; d = pkt[IP].dst
        sport = pkt[TCP].sport; dport = pkt[TCP].dport
        flags = pkt[TCP].flags
        print(f"[{ts}] TCP | {s}:{sport} → {d}:{dport} | {flags} | Len:{len(pkt[TCP].payload)}")
    elif pkt.haslayer(ARP):
        print(f"[{ts}] ARP | {pkt[ARP].psrc} is-at {pkt[ARP].hwsrc}")
    elif pkt.haslayer(DNS) and pkt.haslayer(IP):
        # quick DNS summary
        if pkt.haslayer(Raw):
            payload = pkt[Raw].load.decode(errors="ignore")
            print(f"[{ts}] DNS | {pkt[IP].src} → {pkt[IP].dst} | Payload: {payload[:80]}")
        else:
            print(f"[{ts}] DNS | {pkt[IP].src} → {pkt[IP].dst}")

def packet_handler(pkt):
    human_print(pkt)
    parse_arp(pkt)
    check_for_scan(pkt)

def main():
    parser = argparse.ArgumentParser(description="Network Packet Analyzer & Sniffer")
    parser.add_argument("--interface", "-i", help="Interface to capture on", default="eth0")
    parser.add_argument("--filter", "-f", help="BPF filter", default=None)
    parser.add_argument("--count", "-c", type=int, help="Number of packets to capture", default=0)
    parser.add_argument("--output", "-o", help="Save PCAP to file", default=None)
    parser.add_argument("--verbose", "-v", action="store_true")
    args = parser.parse_args()

    print("NETWORK PACKET ANALYZER & SNIFFER v1.0.0")
    print(f"[*] Interface: {args.interface}")
    print(f"[*] Filter: {args.filter or 'None'}")
    print("[*] Starting capture... Press Ctrl+C to stop.\n")
    pkts = sniff(iface=args.interface, filter=args.filter, prn=packet_handler, count=args.count or None)
    if args.output:
        os.makedirs(os.path.dirname(args.output), exist_ok=True)
        wrpcap(args.output, pkts)
        print(f"Saved PCAP to {args.output}")

if __name__ == "__main__":
    main()
```

